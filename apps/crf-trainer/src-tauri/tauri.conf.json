{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSKK CRF Trainer",
  "version": "0.1.0",
  "identifier": "com.kirameister.pskk.crf-trainer",
  "build": {
    "beforeDevCommand": { "script": "npm run dev -- --host 127.0.0.1", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "devUrl": "http://127.0.0.1:1422",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PSKK CRF Trainer",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
