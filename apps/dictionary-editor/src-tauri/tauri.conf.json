{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSKK Dictionary Editor",
  "version": "0.1.0",
  "identifier": "com.kirameister.pskk.dictionary-editor",
  "build": {
    "beforeDevCommand": "bash -c 'cd ui && npm run dev -- --host 127.0.0.1'",
    "beforeBuildCommand": "bash -c 'cd ui && npm run build'",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PSKK Dictionary Editor",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
