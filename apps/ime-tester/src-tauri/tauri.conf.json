{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSKK IME Tester",
  "version": "0.1.0",
  "identifier": "com.kirameister.pskk.ime-tester",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PSKK IME Tester",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
